# Copy to .env (cp env.example .env) to override the defaults used by docker-compose.yml.
# All values are local development defaults; nothing here is a real credential.
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler
POSTGRES_DB=crawler
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

API_PORT=8080
WORKER_PORT=8081
FRONTEND_PORT=3000
FIXTURE_PORT=8090

# Development enables readable console logs; Production uses JSON logs.
ASPNETCORE_ENVIRONMENT=Production
