{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=crawler;Username=crawler;Password=crawler"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Crawler": {
    "Limits": {
      "DefaultMaxDepth": 2,
      "MaxAllowedDepth": 5,
      "DefaultMaxPages": 200,
      "MaxAllowedPages": 1000
    },
    "Http": {
      "TimeoutSeconds": 10,
      "ConnectTimeoutSeconds": 10,
      "MaxAttempts": 3,
      "RetryBaseDelayMilliseconds": 500,
      "RetryBackoffMultiplier": 2.0,
      "MaxRedirects": 5,
      "MaxResponseBytes": 2097152,
      "MaxRobotsBytes": 512000,
      "PooledConnectionLifetimeSeconds": 120,
      "Concurrency": 4,
      "UserAgent": "CrawlerAssignmentBot/1.0 (+https://github.com/example/crawler)",
      "RespectRobotsTxt": true
    },
    "Security": {
      "TrustedHosts": []
    },
    "Worker": {
      "Prefetch": 2,
      "LeaseSeconds": 60,
      "LeaseRenewSeconds": 15,
      "MaxMessageAttempts": 5,
      "RetryDelaySeconds": 10,
      "RecoverySweepSeconds": 30,
      "PendingRepublishAfterSeconds": 120,
      "RepublishCooldownSeconds": 300,
      "RecoverySweepBatchSize": 50,
      "RequeueDelaySeconds": 5,
      "ReconnectInitialDelaySeconds": 1,
      "ReconnectMaxDelaySeconds": 30,
      "ReconnectBackoffMultiplier": 2.0,
      "DatabaseReadinessPollSeconds": 3
    },
    "Outbox": {
      "PollIntervalSeconds": 2,
      "BatchSize": 50,
      "BackoffMultiplier": 2.0,
      "MaxBackoffSeconds": 30
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "MigrationMaxAttempts": 30,
    "MigrationRetryDelaySeconds": 2
  },
  "Outbox": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Api": {
    "Paging": {
      "DefaultPageSize": 20,
      "MaxPageSize": 100,
      "DefaultLinksPageSize": 100,
      "MaxLinksPageSize": 500
    }
  }
}
