{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=crawler;Username=crawler;Password=crawler"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Crawler": {
    "Limits": {
      "DefaultMaxDepth": 2,
      "MaxAllowedDepth": 5,
      "DefaultMaxPages": 200,
      "MaxAllowedPages": 1000
    },
    "Http": {
      "TimeoutSeconds": 10,
      "MaxAttempts": 3,
      "RetryBaseDelayMilliseconds": 500,
      "MaxRedirects": 5,
      "MaxResponseBytes": 2097152,
      "Concurrency": 4,
      "RespectRobotsTxt": true
    },
    "Security": {
      "TrustedHosts": []
    },
    "Worker": {
      "Prefetch": 2,
      "LeaseSeconds": 60,
      "LeaseRenewSeconds": 15,
      "MaxMessageAttempts": 5,
      "RetryDelaySeconds": 10,
      "RecoverySweepSeconds": 30
    },
    "Outbox": {
      "PollIntervalSeconds": 2,
      "BatchSize": 50
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Outbox": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
